{
  "name": "nanoui",
  "version": "1.0.0",
  "description": "Lightweight UI framework for ESP32 and microcontrollers - Modern web interfaces with minimal memory footprint",
  "main": "dist/nanoui.min.js",
  "scripts": {
    "build": "node tools/build.js",
    "build:dashboard": "node tools/build.js --dashboard",
    "build:showcase": "node tools/build.js --showcase",
    "build:all": "node tools/build.js && node tools/build.js --dashboard && node tools/build.js --showcase",
    "minify": "node tools/minify.js",
    "watch": "node tools/build.js --watch"
  },
  "keywords": [
    "esp32",
    "microcontroller",
    "ui",
    "framework",
    "lightweight",
    "embedded",
    "iot",
    "web-interface"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "clean-css": "^5.3.2",
    "terser": "^5.19.2",
    "html-minifier": "^4.0.0"
  }
}
